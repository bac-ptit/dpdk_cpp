# pixi environments
.pixi/*
!.pixi/config.toml


.idea/*

# Generated documentation
docs/doxygen/

# Local CMake build output
cmake-build-*/

# Generated PCAP shards (regenerated by test/gen_test_pcap.py on demand)
test/bench_pcap_shards/*.pcap

# DPI test pcaps (regenerated by test/dpi_test/gen_dpi_pcap.py for bench runs)
test/dpi_test/dpi_repeated*.pcap
test/dpi_test/shards_repeated/*.pcap

# DPI bench shards (regenerated by test/gen_dpi_bench_pcap.py via test/test_env.sh)
test/dpi_bench_shards/*.pcap
test/dpi_bench_shards_small/*.pcap

# Python bytecode cache (regenerated automatically by Python on import)
__pycache__/
*.pyc

# perf stat captures (large, regenerated per bench session)
bench-results/*.perf
