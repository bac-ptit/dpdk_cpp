# pixi environments
.pixi/*
!.pixi/config.toml


.idea/*

# Generated documentation
docs/doxygen/

# Local CMake build output
cmake-build-*/

# Generated PCAP shards (regenerated by test/gen_test_pcap.py on demand)
test/bench_pcap_shards/*.pcap

# DPI test pcaps (regenerated by test/dpi_test/gen_dpi_pcap.py for bench runs)
test/dpi_test/dpi_repeated*.pcap
test/dpi_test/shards_repeated/*.pcap

# perf stat captures (large, regenerated per bench session)
bench-results/*.perf
